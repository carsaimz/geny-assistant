<?xml version="1.0" encoding="utf-8"?>
<!--
  Geny Network Security Configuration.

  Cleartext (HTTP) traffic is blocked globally. It is permitted ONLY for:
    - 127.0.0.1 / localhost : local Ollama LLM server
    - homeassistant.local   : user-configured Home Assistant on the LAN
  Everything else must use HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">homeassistant.local</domain>
    </domain-config>
</network-security-config>
