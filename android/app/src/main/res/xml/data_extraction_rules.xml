<?xml version="1.0" encoding="utf-8"?>
<!-- Regras de transferencia de dados (Android 12+) — docs §13.2 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="geny_secure.xml" />
        <exclude domain="file" path="audit/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="geny_secure.xml" />
        <exclude domain="file" path="audit/" />
    </device-transfer>
</data-extraction-rules>
