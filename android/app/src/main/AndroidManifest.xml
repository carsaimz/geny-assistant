<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         Permissoes — docs/TECHNICAL_SPEC.md §14.
         Estrategia: solicitadas em contexto, nunca de uma vez.
         ============================================================ -->

    <!-- Rede / integracoes (TLS obrigatorio, cleartext desativado) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voz e audio (Fase 2: STT/TTS/wake word) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Comunicacao (solicitadas em contexto) -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Notificacoes -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Servico em primeiro plano e overlay HUD -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Localizacao (em contexto) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Camera / sensores / bluetooth / wifi (em contexto) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Alarmes exatos para lembretes -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Visibilidade de apps para apps.list/apps.open (API 30+) -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".GenyApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Geny"
        android:usesCleartextTraffic="false"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela nativa de Modelos (Fase 3, android-03 / issue #35) -->
        <activity
            android:name=".models.ModelsActivity"
            android:exported="false"
            android:label="@string/models_title" />

        <!-- Tela nativa de Memória (Fase 5, android-08 / issue #46) -->
        <activity
            android:name=".memory.MemoryActivity"
            android:exported="false"
            android:label="@string/memory_title" />

        <!-- Servico em primeiro plano do assistente (§3.1) -->
        <service
            android:name=".service.AssistantForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|microphone" />

        <!-- Overlay HUD flutuante (§16.2) -->
        <service
            android:name=".overlay.HudOverlayService"
            android:exported="false" />

        <!-- TTS local em primeiro plano (Fase 2, §7.3) -->
        <service
            android:name=".voice.TtsService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Wake word em primeiro plano (Fase 3, TODO android-03b) — desligado por padrão -->
        <service
            android:name=".voice.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Leitura de notificacoes (§9.3) -->
        <service
            android:name=".listener.GenyNotificationListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Receptor de lembretes/alarmes -->
        <receiver
            android:name=".tools.ReminderReceiver"
            android:exported="false" />
    </application>
</manifest>
