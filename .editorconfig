root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts,java}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{rs}]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,json,yml,yaml,css,html}]
indent_style = space
indent_size = 2

[*.lua]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_style = space
indent_size = 4
